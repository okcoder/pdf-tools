#!/bin/sh
set -eu

if [ "$#" -lt 1 ]; then
    echo "使い方: $0 入力.pdf [--answer-pages ページ数] [--rotate] [--labels] [--title TEXT]" >&2
    exit 2
fi

file=$1
shift
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tmp_file=$(mktemp "${TMPDIR:-/tmp}/past-exam-split.XXXXXX")
out_file=$(mktemp "${TMPDIR:-/tmp}/past-exam-output.XXXXXX")
trap 'rm -f "$tmp_file" "$out_file"' EXIT HUP INT TERM

# pdf-split と同じく元のPDFを更新するが、不要な90度回転はしない。
python3 "$script_dir/splitPastExam.py" "$file" "$out_file" "$@"
cp "$file" "$tmp_file.bak"
mv "$out_file" "$file"
echo "$file done. (backup: $tmp_file.bak)"
